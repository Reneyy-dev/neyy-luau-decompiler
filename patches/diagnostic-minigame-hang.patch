+pub fn diagnose_deserialize(bytecode: &[u8], encode_key: u8) -> String {
+    match deserializer::deserialize(bytecode, encode_key) {
+        Err(error) => format!("NEY_DIAG_DESERIALIZE_ERR {:?}", error),
+        Ok(Bytecode::Error(message)) => format!("NEY_DIAG_DESERIALIZE_BYTECODE_ERROR {}", message),
+        Ok(Bytecode::Chunk(chunk)) => format!(
+            "NEY_DIAG_DESERIALIZE_OK functions={} main={}",
+            chunk.functions.len(),
+            chunk.main
+        ),
+    }
+}

+pub fn diagnose_deserialize(bytecode: &[u8], encode_key: u8) -> String {
+    match deserializer::deserialize(bytecode, encode_key) {
+        Err(error) => format!("NEY_DIAG_DESERIALIZE_ERR {:?}", error),
+        Ok(Bytecode::Error(message)) => format!("NEY_DIAG_DESERIALIZE_BYTECODE_ERROR {}", message),
+        Ok(Bytecode::Chunk(chunk)) => format!(
+            "NEY_DIAG_DESERIALIZE_OK functions={} main={}",
+            chunk.functions.len(),
+            chunk.main
+        ),
+    }
+}
+
+pub fn diagnose_lift_all(bytecode: &[u8], encode_key: u8) -> String {
+    let chunk = match deserializer::deserialize(bytecode, encode_key) {
+        Err(error) => return format!("NEY_DIAG_LIFT_DESERIALIZE_ERR {:?}", error),
+        Ok(Bytecode::Error(message)) => {
+            return format!("NEY_DIAG_LIFT_BYTECODE_ERROR {}", message)
+        }
+        Ok(Bytecode::Chunk(chunk)) => chunk,
+    };
+
+    let function_count = chunk.functions.len();
+    let main = chunk.main;
+    let mut lifted = 0usize;
+    let mut stack = vec![(Arc::<Mutex<ast::Function>>::default(), chunk.main)];
+
+    while let Some((_ast_func, func_id)) = stack.pop() {
+        lifted += 1;
+        if lifted > 512 {
+            return format!(
+                "NEY_DIAG_LIFT_TRAVERSAL_LIMIT function_id={} lifted={} pending={}",
+                func_id,
+                lifted,
+                stack.len()
+            );
+        }
+
+        let (_function, _upvalues, child_functions) =
+            Lifter::lift(&chunk.functions, &chunk.string_table, func_id);
+        stack.extend(child_functions.into_iter().map(|(a, f)| (a.0, f)));
+    }
+
+    format!(
+        "NEY_DIAG_LIFT_ALL_OK functions={} main={} lifted={}",
+        function_count,
+        main,
+        lifted
+    )
+}
+
+pub fn diagnose_decompile_prefix(bytecode: &[u8], encode_key: u8, limit: usize) -> String {
+    use std::panic::{catch_unwind, AssertUnwindSafe};
+
+    let chunk = match deserializer::deserialize(bytecode, encode_key) {
+        Err(error) => return format!("NEY_DIAG_PREFIX_DESERIALIZE_ERR {:?}", error),
+        Ok(Bytecode::Error(message)) => {
+            return format!("NEY_DIAG_PREFIX_BYTECODE_ERROR {}", message)
+        }
+        Ok(Bytecode::Chunk(chunk)) => chunk,
+    };
+
+    let function_count = chunk.functions.len();
+    let limit = limit.min(function_count);
+    let mut completed = 0usize;
+    let mut panics = 0usize;
+
+    for function_id in 0..limit {
+        let ast_function = Arc::<Mutex<ast::Function>>::default();
+        let (function, upvalues, _child_functions) =
+            Lifter::lift(&chunk.functions, &chunk.string_table, function_id);
+
+        let result = catch_unwind(AssertUnwindSafe(|| {
+            decompile_function(ast_function, function, upvalues)
+        }));
+
+        if result.is_err() {
+            panics += 1;
+        }
+        completed += 1;
+    }
+
+    format!(
+        "NEY_DIAG_DECOMPILE_PREFIX_OK requested={} completed={} panics={} functions={}",
+        limit,
+        completed,
+        panics,
+        function_count
+    )
+}
